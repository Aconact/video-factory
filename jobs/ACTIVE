# Which Blender job the render workflow runs when this file changes (see .github/scripts/plan.py)
#   job      folder under jobs/ that holds scene.py
#   pct      resolution percentage of 1080x1920
#   samples  Cycles samples per pixel
#   fstart / fend  first and last frame of the shot       frames  optional preview list (1,45,90 or 1-10)
#   shards   parallel GitHub jobs that share the frames
job=pkg
pct=100
samples=32
fstart=1
fend=150
shards=20
